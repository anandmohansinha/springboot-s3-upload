s3_bucket_name = "your-existing-private-s3-bucket"

# For a quick sandbox test, 0.0.0.0/0 is simple but publicly exposes port 8080.
# Prefer your public IP in CIDR form when possible, for example "203.0.113.10/32".
allowed_cidr = "0.0.0.0/0"

# Optional SSH settings. Leave ssh_public_key empty if console/SSH access is
# not needed. For better security, restrict both CIDRs to your own public IP.
ssh_allowed_cidr = "0.0.0.0/0"
ssh_public_key   = ""
